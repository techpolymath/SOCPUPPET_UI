[Unit]
Description=SOCPuppet bridge to the host Metasploit MCP endpoint
Requires=msf-mcp.service
After=docker.service network-online.target msf-mcp.service

[Service]
Type=simple
User=oznog
Group=oznog
RuntimeDirectory=socpuppet-msf-mcp
ExecStart=/usr/sbin/nginx -c /etc/nginx/socpuppet-msf-mcp.conf -g "daemon off;"
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
