# Docker deployment configuration (copy to .env)
# The image is built locally by `docker compose build`; there is no registry tag.
# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0
# to reach it from another machine or from Windows when SOCPUPPET_UI runs inside WSL.
SOCPUPPET_UI_BIND_ADDR=127.0.0.1
# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For the login rate
# limit trusts. Empty: the header is ignored. See "Reverse proxy deployment" in README.md.
SOCPUPPET_UI_TRUSTED_PROXIES=
# Optional key for the secrets encrypted in the database (32 bytes, base64 or hex,
# e.g. `openssl rand -base64 32`). Empty: keys/secret.key, generated at first start.
# Set it when ./keys is not persistent. Losing the key loses the stored secrets.
# SOCPUPPET_UI_SECRET_KEY=
POSTGRES_USER=socpuppet_ui
# The server percent-encodes this into the connection URL, so / ? % @ : and
# spaces are safe. Quote a value that contains #, and write $$ for a literal $,
# because Compose reads this file that way.
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=socpuppet_ui

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SOCPUPPET_UI_LLM_PROVIDER=
SOCPUPPET_UI_LLM_MODEL=
SOCPUPPET_UI_LLM_BASE_URL=
SOCPUPPET_UI_LLM_PROXY=
# Allow the UI model list to reach a local Ollama, e.g. host.docker.internal:11434
SOCPUPPET_UI_LLM_PRIVATE_ENDPOINTS=

# Untrusted-output boundary. Frames every tool output between nonce-tagged markers so
# the model treats it as data, not instructions. On by default (unset or empty = on);
# set SOCPUPPET_UI_UNTRUSTED_BOUNDARY=0 (or false/off/no) to disable it. Measured cost: about
# 154 bytes per tool result plus one system note.
# SOCPUPPET_UI_UNTRUSTED_BOUNDARY=0

# Noise profile of the requests SOCPUPPET_UI sends to targets (WebFetch, http custom tools, enrich
# probe). Default off: no limit, requests unchanged. quiet = 2 req/s per host, burst 4,
# 1 in flight; balanced = 5 req/s, burst 10, 2 in flight; aggressive = 20 req/s, burst 40,
# 4 in flight. A profile also adds jitter, backs off on 429/503 and merges identical GETs
# of one task per tool (short cache; WebFetch is paced only). Bash-launched tools are not throttled.
# SOCPUPPET_UI_NOISE_PROFILE=balanced
# User-Agent set on target requests that have none, only under a profile. Empty = unchanged.
# SOCPUPPET_UI_TARGET_USER_AGENT=

# Run budgets (optional). Unset or 0 = unlimited, nothing changes. TASK_* caps a whole task
# (planner rounds and all its workers); INTENT_* caps one worker run. Kept in memory: a
# restart, or a revive of a finished task, starts a fresh budget.
# Below 50000 tokens a task gets no worker at all (one worker costs about 50000 tokens by
# default); from 50000 to about 70000 it typically gets one worker, then the forced wrap-up. Use a
# budget well above 70000 for real exploration.
# SOCPUPPET_UI_TASK_BUDGET_TOKENS=
# SOCPUPPET_UI_TASK_BUDGET_TURNS=
# SOCPUPPET_UI_INTENT_BUDGET_TOKENS=
# SOCPUPPET_UI_INTENT_BUDGET_TURNS=

# Update banner (optional). SOCPUPPET_UI_UPDATE_CHECK=1 lets the backend check the public GitHub
# releases API for a newer SOCPUPPET_UI release at most once per 24 h and show a dismissible banner.
# Off by default: unset, no update request is made.
# SOCPUPPET_UI_UPDATE_CHECK=1
